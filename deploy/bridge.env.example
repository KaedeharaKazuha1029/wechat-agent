# Install as /etc/weixin-bridge/bridge.env when deploying via systemd.
WEIXIN_BRIDGE_DOT_PORT=17866
WEIXIN_BRIDGE_DOT_PUBLIC_ORIGIN=https://bridge.example.com
WEIXIN_BRIDGE_PUBLIC_ADMIN=0
# Optional: the Runner port on the server side of the reverse SSH tunnel.
# WEIXIN_BRIDGE_CODEX_RUNNER_URL=http://127.0.0.1:17867
# WEIXIN_BRIDGE_CODEX_RUNNER_TOKEN_FILE=/run/credentials/weixin-bridge.service/runner.token
